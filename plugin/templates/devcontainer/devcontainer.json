{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "ADW managed",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "NODE_MAJOR": "22",
      "ADW_AGENT_TOOLS": "both",
      "CODEX_VERSION": "0.146.1",
      "CLAUDE_CODE_VERSION": "2.1.222",
      "ADW_PROJECT_APT_PACKAGES": ""
    }
  },
  "runArgs": [
    "--cap-add=SYS_ADMIN",
    "--cap-add=SYS_CHROOT",
    "--cap-add=SETUID",
    "--cap-add=SETGID",
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp=unconfined",
    "--security-opt=apparmor=unconfined",
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "init": true,
  "updateRemoteUserUID": true,
  "remoteUser": "vscode",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=adw-codex-${devcontainerId},target=/home/vscode/.codex,type=volume",
    "source=adw-claude-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=adw-gh-${devcontainerId},target=/home/vscode/.config/gh,type=volume"
  ],
  "containerEnv": {
    "ADW_MANAGED_DEVCONTAINER": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "postCreateCommand": "sudo /usr/local/bin/adw-init-firewall && sudo /usr/local/bin/adw-post-create && /usr/local/bin/adw-project-setup",
  "postStartCommand": "sudo /usr/local/bin/adw-init-firewall",
  "waitFor": "postStartCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "anthropic.claude-code"
      ]
    }
  }
}
