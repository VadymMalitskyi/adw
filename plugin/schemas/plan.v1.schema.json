{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adw.local/schemas/plan.v1.schema.json",
  "title": "ADW sequential implementation plan v1",
  "type": "object",
  "required": ["schema", "change_id", "summary", "tasks", "documentation"],
  "properties": {
    "schema": { "const": 1 },
    "change_id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]|\\.[a-z0-9_-]+)*$" },
    "summary": { "type": "string", "minLength": 1 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "affected_paths", "validation"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "affected_paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
          },
          "anchors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "restrictions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "validation": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["command", "cwd", "timeout_ms", "required"],
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "cwd": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
                "timeout_ms": { "type": "integer", "minimum": 1 },
                "required": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "documentation": {
      "type": "object",
      "required": ["impact", "files"],
      "properties": {
        "impact": { "enum": ["none", "update", "new"] },
        "files": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
