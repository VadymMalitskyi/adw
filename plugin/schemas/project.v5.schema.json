{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adw.local/schemas/project.v5.schema.json",
  "title": "ADW project configuration v5",
  "type": "object",
  "required": ["schema", "git", "documentation", "execution", "components", "validation"],
  "properties": {
    "schema": { "const": 5 },
    "git": {
      "type": "object",
      "required": ["default_branch"],
      "properties": { "default_branch": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "documentation": {
      "type": "object",
      "required": ["mode", "branch", "worktree", "sync_marker", "delivery"],
      "properties": {
        "mode": { "const": "branch" },
        "branch": { "const": "docs" },
        "worktree": { "const": "worktrees/docs" },
        "sync_marker": { "const": "SYNC.yaml" },
        "delivery": { "const": "direct-push" }
      },
      "additionalProperties": false
    },
    "development": {
      "type": "object",
      "properties": {
        "runtime_versions": {
          "type": "object",
          "properties": {
            "node": { "$ref": "#/$defs/runtimeVersion" },
            "python": { "$ref": "#/$defs/runtimeVersion" },
            "go": { "$ref": "#/$defs/runtimeVersion" },
            "rust": { "$ref": "#/$defs/runtimeVersion" },
            "java": { "$ref": "#/$defs/runtimeVersion" },
            "ruby": { "$ref": "#/$defs/runtimeVersion" },
            "dotnet": { "$ref": "#/$defs/runtimeVersion" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["isolation", "enforcement", "permissions"],
      "properties": {
        "isolation": { "enum": ["managed-devcontainer", "project-devcontainer", "provider-sandbox"] },
        "enforcement": { "enum": ["required", "preferred"] },
        "web_access": { "enum": ["hosted-only", "public-pages"] },
        "permissions": {
          "type": "object",
          "required": ["profile"],
          "properties": { "profile": { "const": "managed-development" } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "validation": { "$ref": "#/$defs/validationStages" }
        },
        "additionalProperties": false
      }
    },
    "validation": { "$ref": "#/$defs/validationStages" },
    "integrations": {
      "type": "object",
      "properties": {
        "work_tracker": { "$ref": "#/$defs/integration" },
        "code_host": { "$ref": "#/$defs/integration" },
        "observability": { "$ref": "#/$defs/integration" },
        "knowledge": { "$ref": "#/$defs/integration" }
      },
      "additionalProperties": false
    },
    "workflows": {
      "type": "object",
      "properties": {
        "work_tracker": {
          "type": "object",
          "required": ["binding", "ensure", "stage", "cardinality"],
          "properties": {
            "binding": { "enum": ["optional", "required"] },
            "ensure": { "enum": ["link-only", "create-or-link"] },
            "stage": { "const": "plan" },
            "cardinality": { "enum": ["one-per-change", "one-parent-plus-plan-tasks"] },
            "profile": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.ya?ml$" },
            "child_profile": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.ya?ml$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "runtimeVersion": {
      "type": "string",
      "pattern": "^\\d+(?:\\.\\d+){0,2}$"
    },
    "command": {
      "type": "object",
      "required": ["command", "source"],
      "properties": {
        "command": { "type": "string", "minLength": 1, "pattern": "^(?!\\s*<[^>]+>\\s*$).+$" },
        "source": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "cwd": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "timeout_ms": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "validationStages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": { "anyOf": [{ "type": "string", "minLength": 1, "pattern": "^(?!\\s*<[^>]+>\\s*$).+$" }, { "$ref": "#/$defs/command" }] }
      }
    },
    "integration": {
      "type": "object",
      "required": ["provider", "requirement"],
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "requirement": { "enum": ["disabled", "optional", "required"] },
        "transport": { "enum": ["auto", "native", "mcp", "cli", "api"] },
        "access": { "enum": ["read-only", "read-write"] },
        "settings": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  }
}
