{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adw.local/schemas/integration.v1.schema.json",
  "title": "ADW external integration bindings v1",
  "type": "object",
  "required": ["schema", "change_id", "bindings"],
  "properties": {
    "schema": { "const": 1 },
    "change_id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]|\\.[a-z0-9_-]+)*$" },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "capability", "provider", "requirement"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9_-]*[a-z0-9])?$" },
          "capability": { "enum": ["work_tracker", "code_host", "observability", "knowledge"] },
          "provider": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "requirement": { "enum": ["optional", "required"] },
          "external_id": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "requirements_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "requirement_fields": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
