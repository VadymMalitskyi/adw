{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adw.local/schemas/approval.v1.schema.json",
  "title": "ADW approval evidence v1",
  "type": "object",
  "required": ["schema", "status", "approver", "approved_at", "plugin_version", "docs_commit", "digest_algorithm", "digest"],
  "properties": {
    "schema": { "const": 1 },
    "status": { "enum": ["active", "superseded"] },
    "approver": { "type": "string", "minLength": 1 },
    "approved_at": { "type": "string", "format": "date-time" },
    "plugin_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "docs_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$", "description": "Commit containing the exact spec and plan bytes before this approval record is committed." },
    "digest_algorithm": { "const": "sha256" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "invalidated_at": { "type": "string", "format": "date-time" },
    "invalidation_reason": { "type": "string", "minLength": 1 },
    "replaced_by": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
