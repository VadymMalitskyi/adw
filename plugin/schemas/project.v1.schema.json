{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adw.local/schemas/project.v1.schema.json",
  "title": "ADW project configuration v1",
  "type": "object",
  "required": ["schema", "git", "documentation", "components", "validation"],
  "properties": {
    "schema": { "const": 1 },
    "git": {
      "type": "object",
      "required": ["default_branch"],
      "properties": {
        "default_branch": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "documentation": {
      "type": "object",
      "required": ["mode", "branch", "worktree", "sync_marker", "delivery"],
      "properties": {
        "mode": { "const": "branch" },
        "branch": { "type": "string", "minLength": 1 },
        "worktree": { "type": "string", "pattern": "^worktrees/[^/]+$" },
        "sync_marker": { "type": "string", "minLength": 1 },
        "delivery": { "enum": ["direct-push", "pull-request"] }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "validation": { "$ref": "#/$defs/validationStages" }
        },
        "additionalProperties": false
      }
    },
    "validation": { "$ref": "#/$defs/validationStages" }
  },
  "additionalProperties": false,
  "$defs": {
    "command": {
      "type": "object",
      "required": ["command", "source"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "validationStages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "$ref": "#/$defs/command" }
          ]
        }
      }
    }
  }
}
