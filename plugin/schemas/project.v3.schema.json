{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adw.local/schemas/project.v3.schema.json",
  "title": "ADW project configuration v3",
  "type": "object",
  "required": ["schema", "git", "documentation", "execution", "components", "validation"],
  "properties": {
    "schema": { "const": 3 },
    "git": {
      "type": "object",
      "required": ["default_branch"],
      "properties": {
        "default_branch": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "documentation": {
      "type": "object",
      "required": ["mode", "branch", "worktree", "sync_marker", "delivery"],
      "properties": {
        "mode": { "const": "branch" },
        "branch": { "type": "string", "minLength": 1 },
        "worktree": { "type": "string", "pattern": "^worktrees/[^/]+$" },
        "sync_marker": { "type": "string", "minLength": 1 },
        "delivery": { "enum": ["direct-push", "pull-request"] }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["isolation", "enforcement"],
      "properties": {
        "isolation": { "enum": ["managed-devcontainer", "project-devcontainer", "provider-sandbox"] },
        "enforcement": { "enum": ["required", "preferred"] }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "validation": { "$ref": "#/$defs/validationStages" }
        },
        "additionalProperties": false
      }
    },
    "validation": { "$ref": "#/$defs/validationStages" },
    "integrations": {
      "type": "object",
      "properties": {
        "work_tracker": { "$ref": "#/$defs/integration" },
        "code_host": { "$ref": "#/$defs/integration" },
        "observability": { "$ref": "#/$defs/integration" },
        "knowledge": { "$ref": "#/$defs/integration" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "command": {
      "type": "object",
      "required": ["command", "source"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "validationStages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "$ref": "#/$defs/command" }
          ]
        }
      }
    },
    "integration": {
      "type": "object",
      "required": ["provider", "requirement"],
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "requirement": { "enum": ["disabled", "optional", "required"] },
        "transport": { "enum": ["auto", "native", "mcp", "cli", "api"] },
        "access": { "enum": ["read-only", "read-write"] },
        "settings": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  }
}
