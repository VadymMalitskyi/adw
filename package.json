{
  "name": "@private/adw-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "Private dual-provider Agentic Development Workflow plugin with optional integrations",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:helper": "node src/helpers/build-bundle.mjs --write",
    "check:helper": "node src/helpers/build-bundle.mjs --check",
    "stage:managed-container": "node src/stage-managed-devcontainer.mjs",
    "test:security": "bash scripts/test-security.sh",
    "test": "node --test",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:helpers": "node --test tests/helpers/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "yaml": "^2.9.0"
  }
}
