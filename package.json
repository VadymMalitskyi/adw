{
  "name": "@private/adw-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Private dual-provider Agentic Development Workflow plugin",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:helper": "node src/helpers/build-bundle.mjs --write",
    "check:helper": "node src/helpers/build-bundle.mjs --check",
    "test": "node --test tests/**/*.test.mjs",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:helpers": "node --test tests/helpers/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs"
  }
}
