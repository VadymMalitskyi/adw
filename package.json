{
  "name": "@private/adw-plugin",
  "version": "1.2.4",
  "private": true,
  "description": "Private dual-provider Agentic Development Workflow plugin with optional integrations",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:vendor": "node src/build-vendor.mjs --write",
    "check:vendor": "node src/build-vendor.mjs --check",
    "test": "node --test",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:security": "bash scripts/test-security.sh"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "yaml": "^2.9.0"
  }
}
